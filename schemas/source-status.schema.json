{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alandaitch/anden/schemas/source-status.schema.json",
  "title": "Estado documental de una fuente",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "state", "checked_at", "public_reference"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": { "type": "string", "minLength": 1, "maxLength": 100 },
    "state": { "enum": ["available", "degraded", "unavailable", "unknown"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "public_reference": { "type": "string", "format": "uri" },
    "note": { "type": "string", "maxLength": 280 }
  }
}
